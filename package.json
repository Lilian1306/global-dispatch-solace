{
  "name": "global-dispatch-solace",
  "version": "1.0.0",
  "description": "Global Dispatch System using Solace PubSub+ and TypeScript for NewCron car haulers",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start:publisher": "ts-node src/publisher/index.ts",
    "start:carriers": "ts-node src/consumer-carriers/index.ts",
    "start:clients": "ts-node src/consumer-clients/index.ts",
    "test": "node --test tests/validator.test.ts"
